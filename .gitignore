# ==============================================================================
# ShoFast Monorepo .gitignore (Python/FastAPI + Android/Kotlin + Docker + Secrets)
# ==============================================================================

# --- Environment & Secrets (CRITICAL - NEVER COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
firebase-adminsdk*.json
supabase-secrets.json

# --- Temporary Media, Video Cache & Private Reports (CRITICAL) ---
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.flv
*.mp3
*.wav
*.aac
tmp/
temp/
shofast_cache/
/tmp/
# Abaikan seluruh file CSV laporan komisi pribadi (kecuali sampel di Docs/)
*.csv
!Docs/**/*.csv

# --- Python / FastAPI Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Android / Kotlin / Gradle ---
android/.gradle/
android/build/
android/*/build/
android/app/build/
android/app/release/
android/app/debug/
android/local.properties
android/.idea/
android/*.iml
android/.cxx/
android/captures/
*.apk
*.aab
*.ap_
*.dex
*.class
# Signing Keystores (CRITICAL)
*.jks
*.keystore
keystore.properties

# --- IDE & Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs & Diagnostics ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
uvicorn.log
node_dump_*.txt
